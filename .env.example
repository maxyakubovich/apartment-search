# Copy to .env for local runs. In GitHub these are repository Secrets.
# .env is gitignored — never commit real values.

# Personal Gmail that receives the Zillow "Instant" saved-search alerts.
# App password, not your account password (requires 2FA enabled):
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=max.v.yakubovich@gmail.com
GMAIL_APP_PASSWORD=

# @BotFather gives you the token. For the chat id: message your bot once, then
# GET https://api.telegram.org/bot<TOKEN>/getUpdates and read result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# https://console.apify.com/account/integrations
APIFY_TOKEN=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Fine-grained PAT with `actions: write` on this repo only. Needed because the
# built-in GITHUB_TOKEN is not allowed to trigger another workflow run.
DISPATCH_PAT=
